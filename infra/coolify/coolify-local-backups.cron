SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

15 3 * * * root /usr/bin/flock -n /run/lock/coolify-local-backup-cron.lock /usr/local/sbin/coolify-local-backup daily >>/var/log/coolify-local-backup.log 2>&1
15 4 * * 0 root /usr/bin/flock -n /run/lock/coolify-local-backup-cron.lock /usr/local/sbin/coolify-local-backup weekly >>/var/log/coolify-local-backup.log 2>&1
